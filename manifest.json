{
  "manifest_version": 3,
  "name": "Conversor para Hangul",
  "version": "2.0",
  "description": "Transforma texto em blocos Hangul (CV e CVC)",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["libs/hangul.js"],
    "matches": ["<all_urls>"]
  }]
}
